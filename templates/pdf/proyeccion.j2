{% extends "base_layout.j2" %}

{% block content %}
    <!-- TÍTULO -->
    <div class="header">
        <h1>ALCALDÍA DE SANTIAGO DE CALI</h1>
        <h2>{{ entidad_destino | upper }}</h2>
        <p style="margin-top:10px; font-weight:bold;">RADICADO No. {{ radicado }}</p>
    </div>

    <!-- DATOS PETICIONARIO -->
    <div class="section">
        <div class="content">
            <strong>Señor(a):</strong> {{ nombre_peticionario }}<br>
            <strong>Identificación:</strong> {{ identificacion }}<br>
            <strong>Asunto:</strong> {{ resumen_solicitud }}
        </div>
    </div>

    <!-- I. ANTECEDENTES -->
    <div class="section">
        <div class="section-title">I. ANTECEDENTES</div>
        <div class="content">
            {{ borrador_proyeccion | safe }}
        </div>
    </div>

    <!-- II. FUNDAMENTOS JURÍDICOS -->
    <div class="section">
        <div class="section-title">II. FUNDAMENTOS JURÍDICOS</div>
        <div class="content">
            <ul class="law-list">
                {% if citas_verificables and citas_verificables is iterable %}
                    {% for ley in citas_verificables %}
                        {% if ley.articulo and ley.texto_relevante %}
                            <li>
                                <span class="law-cite">{{ ley.citacion_formato }} - Art. {{ ley.articulo }} ({{ ley.ente_emisor }}):</span>
                                "{{ ley.texto_relevante }}"
                            </li>
                        {% endif %}
                    {% endfor %}
                {% else %}
                    <li>Normativa general aplicable al derecho de petición según la Ley 1755 de 2015 y Constitución Política.</li>
                {% endif %}
            </ul>
        </div>
    </div>

    <!-- III. RESOLUCIÓN -->
    <div class="section">
        <div class="section-title">III. RESOLUCIÓN</div>
        <div class="content">
            <p>En mérito de lo expuesto, la Secretaría competente RESUELVE:</p>
            <p>Dar respuesta de fondo a la solicitud del ciudadano en un término máximo de {{ plazo_dias }} días hábiles, conforme al canal de notificación {{ canal_notificacion }}.</p>
        </div>
    </div>

    {# Firmas Proyectadas #}
    <div class="signature">
        <div class="signature-line"></div>
        <p class="signature-name">SECRETARÍA DE DESPACHO</p>
        <p class="signature-role">Firma Electrónica Autorizada - Alcaldía de Cali</p>
    </div>
{% endblock %}
