{% extends "base_layout.j2" %}

{% block content %}
    <div class="header">
        <h1>ALCALDÍA DE SANTIAGO DE CALI</h1>
        <h2>MEMORIAL DE REQUERIMIENTO CIUDADANO</h2>
        <p style="margin-top:10px; font-weight:bold;">Radicado No. {{ radicado }}</p>
    </div>

    <div class="section">
        <div class="section-title">DATOS DEL PETICIONARIO</div>
        <div class="content">
            <table class="data-table">
                <tr>
                    <td class="label">Nombre completo:</td>
                    <td class="value">{{ nombre_peticionario }}</td>
                </tr>
                <tr>
                    <td class="label">Identificación:</td>
                    <td class="value">{{ identificacion }}</td>
                </tr>
                <tr>
                    <td class="label">Correo electrónico:</td>
                    <td class="value">{{ email }}</td>
                </tr>
                <tr>
                    <td class="label">Celular:</td>
                    <td class="value">{{ celular }}</td>
                </tr>
                <tr>
                    <td class="label">Dirección:</td>
                    <td class="value">{{ direccion }}</td>
                </tr>
                <tr>
                    <td class="label">Entidad/JAC:</td>
                    <td class="value">{{ entidad_solicitante }}</td>
                </tr>
            </table>
        </div>
    </div>

    <div class="section">
        <div class="section-title">I. SOLICITUD ORIGINAL</div>
        <div class="content">
            <p class="highlight">" {{ resumen_solicitud }} "</p>
        </div>
    </div>

    <div class="section">
        <div class="section-title">II. RELATO TÉCNICO DE LOS HECHOS</div>
        <div class="content">
            {{ hechos_extraidos | safe }}
        </div>
    </div>

    <div class="section">
        <div class="section-title">III. FUNDAMENTACIÓN JURÍDICA</div>
        <div class="content">
            <ul class="law-list">
                {% if citas_verificables and citas_verificables is iterable %}
                    {% for ley in citas_verificables %}
                        {% if ley.articulo %}
                            <li>
                                <span class="law-cite">{{ ley.citacion_formato }} - Art. {{ ley.articulo }}:</span>
                                "{{ ley.texto_relevante }}"
                            </li>
                        {% endif %}
                    {% endfor %}
                {% else %}
                    <li>Normativa general regulada por la Ley 1755 de 2015 sobre el Derecho de Petición.</li>
                {% endif %}
            </ul>
        </div>
    </div>

    <div class="signature">
        <div class="signature-line"></div>
        <p class="signature-name">{{ nombre_peticionario | upper }}</p>
        <p class="signature-role">Firma Digital del Peticionario - Sello Inmutable</p>
    </div>
{% endblock %}
