# === ORBITAL PRIME - PRODUCTION CONFIG (GCP) ===
# This configuration uses GCP services exclusively

# === 🔐 Seguridad y autenticación ===
JWT_SECRET=${JWT_SECRET_PROD}
JWT_REFRESH_SECRET=${JWT_REFRESH_SECRET_PROD}
GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID_PROD}
GOOGLE_CLIENT_SECRET=${GOOGLE_CLIENT_SECRET_PROD}

# === 🌐 URLs del sistema ===
# Cloud Run service URL will be injected at deployment time
PUBLIC_BACKEND_URL=https://${CLOUD_RUN_URL}

# === 🧠 Vertex AI (GCP IA) ===
AI_PROVIDER=vertex
GCP_PROJECT_ID=${GCP_PROJECT_ID}
GCP_LOCATION=us-central1
VERTEX_MODEL_NAME=gemini-1.5-pro
VERTEX_EMBEDDING_MODEL=text-embedding-005
VERTEX_EMBEDDING_DIMENSIONS=768

# === 📦 Cloud SQL (PostgreSQL) ===
# Replaces Azure Database for PostgreSQL
DB_HOST=${CLOUD_SQL_HOST}
DB_PORT=5432
DB_USERNAME=${CLOUD_SQL_USER_PROD}
DB_PASSWORD=${CLOUD_SQL_PASSWORD_PROD}
DB_NAME=govdocs_prod
DB_SSL=true
DATABASE_URL=postgresql+asyncpg://${CLOUD_SQL_USER_PROD}:${CLOUD_SQL_PASSWORD_PROD}@${CLOUD_SQL_HOST}:5432/govdocs_prod?sslmode=require

# === 📄 Cloud Storage (GCS) ===
# Replaces Azure Blob Storage
GCS_BUCKET_NAME=${GCS_BUCKET_NAME_PROD}
GCS_SIGNED_URL_EXPIRY_HOURS=1
GCS_ARCHIVE_STORAGE_CLASS=ARCHIVE

# === 🗄️ MongoDB / Document Store ===
# Migration Strategy: Use MongoDB Atlas on GCP
MONGODB_PROVIDER=atlas
MONGODB_ATLAS_URI=${MONGODB_ATLAS_URI_PROD}
MONGODB_ATLAS_DB=govdocs_prod
MONGO_URL=${MONGODB_ATLAS_URI_PROD}
MONGO_DB=govdocs_prod

# === 📨 Notification & Communication ===
# GCP Cloud Tasks (replaces Service Bus) + Mailgun (replaces ACS)
MAILGUN_API_KEY=${MAILGUN_API_KEY}
MAILGUN_DOMAIN=${MAILGUN_DOMAIN}
NOTIFICATION_EMAIL=noreply@${MAILGUN_DOMAIN}

# === 🧪 Entorno y puertos ===
NODE_ENV=production
PORT=3001
LOG_LEVEL=info
ENVIRONMENT=production

# === 🔑 Secret Manager ===
# Secrets are loaded from Google Cloud Secret Manager at runtime via Workload Identity
# No secrets should be embedded in this file

# === 💾 Redis / Memorystore ===
# Replaces local Redis with Google Cloud Memorystore
REDIS_URL=redis://${MEMORYSTORE_REDIS_HOST}:6379/0
REDIS_TTL=900

# === 📊 Monitoring & Logging ===
# Google Cloud Logging is automatic with Cloud Run
# Enable Cloud Trace for distributed tracing
ENABLE_CLOUD_TRACE=true
# Enable Cloud Profiler for performance optimization
ENABLE_CLOUD_PROFILER=true
# Enable custom metrics
ENABLE_CUSTOM_METRICS=true

# === 🧮 Configuración de la API ===
API_CALLBACK_URL=https://${CLOUD_RUN_URL}/api/v1/callbacks
INTERNAL_API_KEY=${INTERNAL_API_KEY_PROD}
API_TIMEOUT_SECONDS=30

# === 🔗 Integration con sistema principal ===
MAIN_BACKEND_URL=${MAIN_BACKEND_URL_PROD}
MAIN_BACKEND_LOGIN_PATH=/api/v1/auth/login
MAIN_BACKEND_VERIFY_PATH=/api/v1/auth/me
MAIN_BACKEND_TIMEOUT_SECONDS=12

# === 📝 CORS ===
CORS_ORIGINS=https://${FRONTEND_DOMAIN},https://yourdomain.com

# === 🛡️ Security Headers ===
SECURITY_HEADERS=true
ENABLE_HTTPS_REDIRECT=true

# === 📤 Health Check ===
HEALTHZ_PATH=/healthz
READINESS_PATH=/ready
