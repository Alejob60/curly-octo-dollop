# Create .env.production.local with actual secrets before deployment
# This file is gitignored and should be populated with real values

# === Required Secrets (get these from GCP Secret Manager) ===
JWT_SECRET_PROD=placeholder_jwt_secret_from_secret_manager
JWT_REFRESH_SECRET_PROD=placeholder_refresh_secret_from_secret_manager
GOOGLE_CLIENT_ID_PROD=placeholder_gcp_oauth_client_id
GOOGLE_CLIENT_SECRET_PROD=placeholder_gcp_oauth_secret

# === GCP Resources ===
GCP_PROJECT_ID=your-gcp-project-id
CLOUD_SQL_HOST=your-cloudsql-instance:us-central1:govdocs-db
CLOUD_SQL_USER_PROD=govdocs_user
CLOUD_SQL_PASSWORD_PROD=strong_password_here
GCS_BUCKET_NAME_PROD=orbital-prime-govdocs-prod
MEMORYSTORE_REDIS_HOST=your-memorystore-redis-host

# === MongoDB Atlas ===
MONGODB_ATLAS_URI_PROD=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_ATLAS_DB=govdocs_prod

# === Mailgun (for production email) ===
MAILGUN_API_KEY=mg-key-from-mailgun
MAILGUN_DOMAIN=mail.yourdomain.com

# === API Keys ===
INTERNAL_API_KEY_PROD=strong_internal_api_key_here

# === Main Backend Integration ===
MAIN_BACKEND_URL_PROD=https://main-backend.yourdomain.com

# === Frontend Domain ===
FRONTEND_DOMAIN=app.yourdomain.com
