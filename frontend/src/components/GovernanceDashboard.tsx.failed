import React, { useState, useEffect } from "react";
import { 
  LayoutDashboard, ShieldCheck, Zap, 
  Search, Filter, RefreshCw, CheckCircle2, AlertTriangle, Clock
} from "lucide-react";
import { CaseTable } from "./dashboard/CaseTable";
import { CopilotPanel } from "./dashboard/CopilotPanel";
import { useDashboardStore } from "../store/useDashboardStore";
import { dashboardApi } from "../lib/api";

export function GovernanceDashboard() {
  const { filters, setFilters, selectedIds, clearSelection } = useDashboardStore();
  const [cases, setCases] = useState([]);
  const [stats, setStats] = useState({ AUTO_APPROVE: 0, REVIEW: 0, EMERGENCY: 0, HUMAN_ONLY: 0 });
  const [isLoading, setIsLoading] = useState(true);
  const [isApproving, setIsApproving] = useState(false);
  const [activeSessionId, setActiveSessionId] = useState<string | null>(null);

  const fetchData = async () => {
    setIsLoading(true);
    try {
      const [casesRes, statsRes] = await Promise.all([
        dashboardApi.getCases({
          status: filters.status !== 'all' ? filters.status : undefined,
          dependency_id: filters.dependencyId !== 'all' ? filters.dependencyId : undefined,
          min_confidence: filters.minConfidence > 0 ? filters.minConfidence / 100 : undefined
        }),
        dashboardApi.getQueueStats()
      ]);
      
      setCases(casesRes.items || []);
      setStats(statsRes.queues || {});
    } catch (error) {
      console.error("Error fetching dashboard data:", error);
    } finally {
      setIsLoading(false);
    }
  };

  useEffect(() => {
    fetchData();
  }, [filters]);

  const handleBatchApprove = async () => {
    if (selectedIds.length === 0) return;
    setIsApproving(true);
    try {
      const res = await dashboardApi.approveBatch(selectedIds);
      alert(`Éxito: ${res.success.length} casos firmados. Fallidos: ${res.failed.length}`);
      clearSelection();
      fetchData();
    } catch (error) {
      console.error("Error approving batch:", error);
    } finally {
      setIsApproving(false);
    }
  };

  return (
    <div className="flex-1 flex bg-slate-50 dark:bg-[#020617] overflow-hidden">
      <div className="flex-1 flex flex-col overflow-hidden">
        {/* HEADER PRINCIPAL */}
        <header className="px-8 py-6 bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800 flex justify-between items-center shrink-0">
          <div>
            <h1 className="text-2xl font-black text-slate-900 dark:text-white tracking-tight uppercase flex items-center gap-3">
              <div className="p-2 bg-indigo-600 rounded-lg shadow-lg shadow-indigo-500/20">
                <LayoutDashboard className="w-6 h-6 text-white" />
              </div>
              Gobernanza Híbrida V55.1
            </h1>
            <p className="text-xs font-bold text-slate-400 dark:text-slate-500 mt-1 uppercase tracking-widest">
              Panel de Control y Supervisión de Expedientes con IA
            </p>
          </div>

          <div className="flex items-center gap-4">
            <button 
              onClick={fetchData}
              className="p-2 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-full transition-colors text-slate-500"
            >
              <RefreshCw size={20} className={isLoading ? "animate-spin" : ""} />
            </button>
            <div className="h-8 w-[1px] bg-slate-200 dark:bg-slate-800"></div>
            <div className="flex items-center gap-2 px-4 py-2 bg-emerald-50 dark:bg-emerald-900/20 text-emerald-700 dark:text-emerald-400 rounded-full text-[10px] font-black border border-emerald-100 dark:border-emerald-800 shadow-sm">
              <ShieldCheck className="w-4 h-4" /> AUDIT ACTIVE
            </div>
          </div>
        </header>

        {/* ÁREA DE CONTENIDO */}
        <div className="flex-1 overflow-y-auto p-8 custom-scrollbar">
          {/* KPI CARDS */}
          <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
            <div className="bg-white dark:bg-slate-900 p-6 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
              <div className="flex justify-between items-start mb-4">
                <div className="p-2 bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 rounded-xl">
                  <CheckCircle2 size={24} />
                </div>
                <span className="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Auto-Firmable</span>
              </div>
              <h3 className="text-3xl font-black text-slate-900 dark:text-white">{stats.AUTO_APPROVE || 0}</h3>
              <p className="text-[10px] text-slate-500 mt-1 uppercase font-bold">Confianza ≥ 95%</p>
            </div>

            <div className="bg-white dark:bg-slate-900 p-6 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
              <div className="flex justify-between items-start mb-4">
                <div className="p-2 bg-amber-50 dark:bg-amber-900/30 text-amber-600 dark:text-amber-400 rounded-xl">
                  <Zap size={24} />
                </div>
                <span className="text-[10px] font-bold text-slate-400 uppercase tracking-wider">En Revisión</span>
              </div>
              <h3 className="text-3xl font-black text-slate-900 dark:text-white">{stats.REVIEW || 0}</h3>
              <p className="text-[10px] text-slate-500 mt-1 uppercase font-bold">Confianza 70-94%</p>
            </div>

            <div className="bg-white dark:bg-slate-900 p-6 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
              <div className="flex justify-between items-start mb-4">
                <div className="p-2 bg-rose-50 dark:bg-rose-900/30 text-rose-600 dark:text-rose-400 rounded-xl">
                  <AlertTriangle size={24} />
                </div>
                <span className="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Emergencias</span>
              </div>
              <h3 className="text-3xl font-black text-slate-900 dark:text-white">{stats.EMERGENCY || 0}</h3>
              <p className="text-[10px] text-slate-500 mt-1 uppercase font-bold">Urgencia Vital</p>
            </div>

            <div className="bg-white dark:bg-slate-900 p-6 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
              <div className="flex justify-between items-start mb-4">
                <div className="p-2 bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 rounded-xl">
                  <Clock size={24} />
                </div>
                <span className="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Solo Humano</span>
              </div>
              <h3 className="text-3xl font-black text-slate-900 dark:text-white">{stats.HUMAN_ONLY || 0}</h3>
              <p className="text-[10px] text-slate-500 mt-1 uppercase font-bold">Fallo IA / Complejo</p>
            </div>
          </div>

          {/* BARRA DE ACCIONES Y FILTROS */}
          <div className="bg-white dark:bg-slate-900 p-4 rounded-xl border border-slate-200 dark:border-slate-800 shadow-sm mb-6 flex flex-wrap gap-4 items-center justify-between">
            <div className="flex items-center gap-4 flex-1">
              <div className="relative flex-1 max-w-md">
                <Search className="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400" size={18} />
                <input 
                  type="text" 
                  placeholder="Buscar por radicado o documento..." 
                  className="w-full pl-10 pr-4 py-2 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none transition-all dark:text-white"
                  value={filters.search}
                  onChange={(e) => setFilters({ search: e.target.value })}
                />
              </div>
              <div className="flex items-center gap-2">
                <Filter size={18} className="text-slate-400" />
                <select 
                  className="bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg px-3 py-2 text-sm outline-none dark:text-white"
                  value={filters.dependencyId}
                  onChange={(e) => setFilters({ dependencyId: e.target.value })}
                >
                  <option value="all">Todas las Dependencias</option>
                  <option value="4152">Movilidad</option>
                  <option value="4135">Salud</option>
                  <option value="2201">Educación</option>
                </select>
              </div>
            </div>

            <div className="flex items-center gap-3">
              {selectedIds.length > 0 && (
                <div className="flex items-center gap-3 animate-in fade-in zoom-in duration-200">
                  <span className="text-xs font-bold text-slate-500 uppercase">{selectedIds.length} seleccionados</span>
                  <button 
                    onClick={handleBatchApprove}
                    disabled={isApproving}
                    className="px-6 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg text-xs font-black uppercase tracking-widest shadow-lg shadow-indigo-500/30 transition-all disabled:opacity-50"
                  >
                    {isApproving ? "Procesando..." : "Firmar en Lote"}
                  </button>
                </div>
              )}
            </div>
          </div>

          {/* TABLA DE CASOS */}
          <CaseTable 
            cases={cases} 
            isLoading={isLoading} 
            onRowClick={(id) => setActiveSessionId(id)}
          />
        </div>
      </div>

      {/* PANEL LATERAL DE COPILOTO */}
      {activeSessionId && (
        <CopilotPanel 
          sessionId={activeSessionId} 
          onClose={() => setActiveSessionId(null)} 
        />
      )}
    </div>
  );
}
